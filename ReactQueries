/*
Example 2: Redux Thunk (Most Common)

You've already learned createAsyncThunk.

Thunk itself is a middleware.

When you do:

dispatch(fetchEmployees());
Middleware intercepts it.

dispatch(fetchEmployees())
          │
          ▼
     Thunk Middleware
          │
     API Call
          │
          ▼
dispatch(success)
          │
          ▼
Reducer

Without middleware, Redux would only accept plain action objects.
*/


// store.js
import { configureStore } from "@reduxjs/toolkit";

import authReducer from "../features/auth/authSlice";
import employeeReducer from "../features/employee/employeeSlice";
import loggerMiddleware from "../middleware/loggerMiddleware";

export const store = configureStore({
  reducer: {
    auth: authReducer,
    employee: employeeReducer,
  },

  middleware: (getDefaultMiddleware) =>
    getDefaultMiddleware().concat(loggerMiddleware),
});


// Instead of writing console.log() everywhere, we create one middleware.
const loggerMiddleware = (store) => (next) => (action) => {

  console.log("Action:", action.type);
  console.log("Previous State:", store.getState());

  const result = next(action);

  console.log("New State:", store.getState());

  return result;
};

export default loggerMiddleware;

dispatch(deleteEmployee(5));

// Logs
