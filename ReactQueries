import { useState } from "react";
import Count from "./Count";
import UserDetails from "./UserDetails";
import Card from "./Card";
import Layout from "./Layout";
import Wrapper from "./Wrapper";

function User() {
    const [checkBoxValue, setCheckBoxValue] = useState([]);
    const [gender, setGender] = useState('male');
    const [city, setCity] = useState('delhi');

    const handleCheckBox = (event) => {
        if (event.target.checked) {
            setCheckBoxValue([...checkBoxValue, event.target.value]);
        } else {
            setCheckBoxValue([...checkBoxValue.filter(value => value != event.target.value)]);
        }
    };

    const handleGender = (event) => {
        setGender(event.target.value);
    };

    const handleCity = (event) => {
        setCity(event.target.value)
    }

    return (
        <>
            <h2>User Login Component</h2>
            <div>
                <h3>Select Skills</h3>
                <input type="checkbox" onChange={handleCheckBox} id="node" value="node" />
                <label htmlFor="node">Node</label><br />

                <input type="checkbox" onChange={handleCheckBox} id="javascript" value="javascript" />
                <label htmlFor="javascript">Javascript</label><br />

                <input type="checkbox" onChange={handleCheckBox} id="react" value="react" />
                <label htmlFor="react">React</label><br />

                <input type="checkbox" onChange={handleCheckBox} id="mongoDb" value="mongoDb" />
                <label htmlFor="mongoDb">mongoDb</label><br />

                <h2>Selected skills: {checkBoxValue.join(', ')} </h2>
                <hr />
            </div>

            <div>
                <h3>Handle Check Box</h3>
                <p>Select Gender</p>
                <input type="radio" onChange={handleGender} checked={gender == 'male'} id="male" value="male" name="gender" />
                <label htmlFor="male">Male</label>

                <input type="radio" onChange={handleGender} checked={gender == 'female'} id="female" value="female" name="gender" />
                <label htmlFor="female">Female</label>
                <h2>Selected Gender: {gender}</h2>
                <hr />
            </div>

            <div>
                <h3>Handle Dropdown</h3>
                <select onChange={handleCity} defaultValue={"delhi"}>
                    <option value="noida">Noida</option>
                    <option value="bihar">Bihar</option>
                    <option value="delhi">Delhi</option>
                </select>
                <h2>Selected City: {city}</h2>
            </div>
        </>
    )
};

export default User;